---
import { education } from "@/data/education";
import { achievements } from "@/data/achievements";
---

<section
  id="education"
  class="py-12 border-t border-[#ffffff10] text-[var(--color-on-surface)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--color-primary)] mb-2 shiny-sec">Formación</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Educación</h3>

    <div class="space-y-6">
      {
        education.map((edu) => (
          <div class="bg-[var(--color-component-bg)] border border-[var(--color-on-surface-subtle)] rounded-2xl p-6 transition-all duration-300 hover:border-[var(--color-on-surface-muted)]">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-2">
              <h4 class="text-lg md:text-xl font-semibold text-[var(--color-on-surface)]">
                {edu.degree}
              </h4>
              <span class="text-sm text-[var(--color-on-surface-muted)] font-medium shrink-0">
                {edu.startDate === edu.endDate ? edu.startDate : `${edu.startDate} — ${edu.endDate}`}
              </span>
            </div>
            <p class="text-[var(--color-primary)] font-medium mb-1">
              {edu.institution}
            </p>
            {edu.description && (
              <p class="text-[var(--color-on-surface-muted)] text-sm leading-relaxed">
                {edu.description}
              </p>
            )}
          </div>
        ))
      }
    </div>

    {
      achievements.length > 0 && (
        <div class="mt-10">
          <h4 class="text-lg text-[var(--color-primary)] mb-4 shiny-sec">Logros Destacados</h4>
          <div class="space-y-4">
            {achievements.map((achievement) => (
              <div class="flex items-start gap-4 bg-[var(--color-component-bg)] border border-[var(--color-primary)]/30 rounded-2xl p-5">
                <div class="shrink-0 mt-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-6 text-[var(--color-primary)]"
                  >
                    <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 11.99H19.8C19.36 15.61 16.17 18.87 12 20.08V12H4.2V6.38L12 3.19V11.99Z" />
                  </svg>
                </div>
                <div>
                  <h5 class="text-[var(--color-on-surface)] font-semibold mb-1">
                    {achievement.title}
                  </h5>
                  <p class="text-[var(--color-on-surface-muted)] text-sm leading-relaxed">
                    {achievement.description}
                  </p>
                  <span class="inline-block mt-2 text-xs font-medium text-[var(--color-primary)] bg-[var(--color-primary)]/10 px-2 py-1 rounded-full">
                    {achievement.year}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

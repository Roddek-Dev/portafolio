---
import { experiences } from "@/data/experience";
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--color-on-surface)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--color-primary)] mb-2 shiny-sec">Experiencia</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Trayectoria Profesional</h3>

    <div class="space-y-8">
      {
        experiences.map((exp) => (
          <div class="relative pl-8 md:pl-10 border-l-2 border-[var(--color-on-surface-subtle)]">
            <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-[var(--color-primary)]" />
            <div class="space-y-2">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-1">
                <h4 class="text-xl md:text-2xl font-semibold text-[var(--color-on-surface)]">
                  {exp.role}
                </h4>
                <span class="text-sm text-[var(--color-on-surface-muted)] font-medium">
                  {exp.startDate} — {exp.endDate}
                </span>
              </div>
              <p class="text-[var(--color-primary)] font-medium">
                {exp.company}
                {exp.location && (
                  <span class="text-[var(--color-on-surface-muted)]">
                    · {exp.location}
                  </span>
                )}
              </p>
              <p class="text-[var(--color-on-surface-muted)] leading-relaxed">
                {exp.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
